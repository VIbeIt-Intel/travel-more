{
  "name": "travel-more",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:github-pages": "node scripts/github-pages.mjs build",
    "build:github-pages-domain": "node scripts/github-pages.mjs build-domain",
    "deploy:github-pages": "npm run build:github-pages && npx gh-pages -d out --dotfiles -m \"Deploy public site\"",
    "deploy:domain": "npm run build:github-pages-domain && npx gh-pages -d out --dotfiles -m \"Deploy for travelmorebl.com\"",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "next": "^15.5.6",
    "nodemailer": "^7.0.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
